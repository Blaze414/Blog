# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# generated responsive image variants (created by predev/prebuild)
/public/_optimized/

# generated Office preview workers and asset manifest (created by Vite)
/public/vendor/
/public/flyfish-viewer-assets.json

# transactional article-import journals, locks and receipts
/.article-import/

# User-supplied document fixtures served only by the local Vite development server
/.local-test-assets/
