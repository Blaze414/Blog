{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "import:articles": "node scripts/import-articles.mjs && npm run optimize:images",
    "import:articles:dry-run": "node scripts/import-articles.mjs --dry-run",
    "import:articles:watch": "node scripts/watch-article-imports.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "predev": "npm run assets:viewer && npm run optimize:images",
    "dev": "node scripts/dev-with-imports.mjs",
    "dev:site": "next dev",
    "prebuild": "npm run assets:viewer && npm run optimize:images",
    "build": "next build",
    "start": "next start",
    "test": "npm run build:worker && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/vendor --ignore-pattern .remember --ignore-pattern graphify-out --ignore-pattern .codex",
    "db:generate": "drizzle-kit generate",
    "build:worker": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "dev:worker": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "start:worker": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "assets:viewer": "node scripts/copy-viewer-assets.mjs",
    "verify:build": "npm run build && node scripts/verify-next-build.mjs"
  },
  "dependencies": {
    "@file-viewer/core": "^2.2.3",
    "@file-viewer/preset-office": "^2.2.3",
    "@file-viewer/react": "^2.2.3",
    "buffer": "^6.0.3",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^12.42.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@file-viewer/vite-plugin": "^2.2.3",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
